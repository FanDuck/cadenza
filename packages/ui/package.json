{
  "name": "@fanduck/cadenza-ui",
  "version": "0.1.0",
  "description": "Themeable Web Components for building Cadenza music player interfaces",
  "license": "MIT",
  "author": "FanDuck",
  "type": "module",
  "sideEffects": [
    "./src/theme.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "files": [
    "dist",
    "src/theme.css"
  ],
  "keywords": [
    "web-components",
    "music",
    "player",
    "ui",
    "theme"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
